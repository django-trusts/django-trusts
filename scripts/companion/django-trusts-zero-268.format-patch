From 60b1e78f46a251a04c05c0fc6cf0c74824c90f4c Mon Sep 17 00:00:00 2001
From: Grok For Thomas <thomasleaf+grok@gmail.com>
Date: Tue, 3 Nov 2026 04:44:32 +0000
Subject: [PATCH django-trusts-zero] fix: match Core parse_perm_code binding on
 content model (#268)

resolve_content_permission uses app_label and codename from parse_perm_code
and the passed model's content type. Legacy permission_required lookups load
the model from the matching Permission row. List paths fail closed when the
row is absent.
---
 tests/runtests.py         |  1 +
 tests/test_issue268.py    | 27 +++++++++++++++++++++++++++
 trusts/zero/decorators.py | 27 +++++++++++++++++++++------
 trusts/zero/policy.py     |  8 ++++----
 trusts/zero/query.py      | 12 ++++++++++--
 5 files changed, 63 insertions(+), 12 deletions(-)
 create mode 100644 tests/test_issue268.py

diff --git a/tests/runtests.py b/tests/runtests.py
index ce919d4..6b683e9 100644
--- a/tests/runtests.py
+++ b/tests/runtests.py
@@ -49,6 +49,7 @@ NORMAL_SUITE = [
     'tests.test_issue149',
     'tests.test_issue248',
     'tests.test_issue267',
+    'tests.test_issue268',
     'tests.test_issue314',
     'tests.test_decorators',
     'tests.test_smoke',
diff --git a/tests/test_issue268.py b/tests/test_issue268.py
new file mode 100644
index 0000000..fe6f409
--- /dev/null
+++ b/tests/test_issue268.py
@@ -0,0 +1,27 @@
+"""Zero paired with Core #268: dotted codes use the queryset content model."""
+
+from django.contrib.auth.models import Permission
+from django.contrib.contenttypes.models import ContentType
+from django.core.management import call_command
+from django.test import TestCase
+
+from tests.models import Category
+from tests.runtests import NORMAL_SUITE
+
+
+class ExactCodenameResolutionZeroTest(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        call_command('create_trust_root')
+
+    def test_module_is_on_the_zero_suite(self):
+        self.assertIn('tests.test_issue268', NORMAL_SUITE)
+
+    def test_dotted_code_resolves_on_the_queryset_model_not_the_codename_suffix(self):
+        category_type = ContentType.objects.get_for_model(Category)
+        permission = Permission.objects.get(
+            content_type=category_type, codename='read_category',
+        )
+        resolved = Category.objects.get_permission('trusts_zero_tests.read_category')
+        self.assertEqual(resolved.pk, permission.pk)
+        self.assertEqual(resolved.content_type, category_type)
diff --git a/trusts/zero/decorators.py b/trusts/zero/decorators.py
index cb78746..e0a7c72 100644
--- a/trusts/zero/decorators.py
+++ b/trusts/zero/decorators.py
@@ -16,6 +16,7 @@ from django.shortcuts import resolve_url
 from django.http import Http404
 
 from trusts.utils import parse_perm_code
+from trusts.zero import get_permission_model
 
 
 class P(object):
@@ -145,14 +146,28 @@ def _get_permissible_items(perm, request, fieldlookups):
     if fieldlookups is None:
         return None
 
-    applabel, modelname, action, cond = parse_perm_code(perm)
+    applabel, codename, cond = parse_perm_code(perm)
+    if cond:
+        raise ValueError(
+            'Permission-required field lookups do not support a :condition '
+            'suffix: %r' % perm
+        )
+    Permission = get_permission_model()
     try:
         content_type = django_apps.get_model('contenttypes', 'ContentType')
-        ctype = content_type.objects.get_by_natural_key(applabel, modelname)
-
-        return ctype.model_class().objects.filter(**fieldlookups)
-    except ObjectDoesNotExist:
-        raise ValueError('Permission code must be of the form "app_label.action_modelname". Actual: %s' % perm)
+        permission = Permission.objects.get(
+            codename=codename,
+            content_type__app_label=applabel.lower(),
+        )
+        model = permission.content_type.model_class()
+        if model is None:
+            raise ObjectDoesNotExist
+        return model.objects.filter(**fieldlookups)
+    except (Permission.DoesNotExist, ObjectDoesNotExist):
+        raise ValueError(
+            'Permission code must be one app_label.codename string that '
+            'matches an auth.Permission row. Actual: %s' % perm
+        )
 
 
 def _resolve_fieldlookups(request, kwargs, fieldlookups_kwargs=None, fieldlookups_getparams=None, fieldlookups_postparams=None, **fieldlookups):
diff --git a/trusts/zero/policy.py b/trusts/zero/policy.py
index a3b9100..4150c0c 100644
--- a/trusts/zero/policy.py
+++ b/trusts/zero/policy.py
@@ -29,7 +29,7 @@ def _condition_suffix(perm):
         return ''
     if '.' not in head:
         return tail
-    return parse_perm_code(perm)[3]
+    return parse_perm_code(perm)[2]
 
 
 def reject_queryable_condition(perm, api_name):
@@ -64,10 +64,10 @@ def resolve_content_permission(model, perm):
     perm = str(perm)
     if '.' in perm:
         try:
-            applabel, modelname, action, _cond = parse_perm_code(perm)
-            perm = '%s_%s' % (action, modelname)
+            applabel, codename, _cond = parse_perm_code(perm)
+            perm = codename
             app_label = applabel
-            model_name = modelname
+            model_name = model._meta.model_name
         except ValueError:
             app_label, perm = perm.split('.', 1)
     if ':' in perm:
diff --git a/trusts/zero/query.py b/trusts/zero/query.py
index 472215e..0850bfe 100644
--- a/trusts/zero/query.py
+++ b/trusts/zero/query.py
@@ -12,6 +12,7 @@ from trusts.decorators import filter_by_permitted_content
 from trusts.models import AuthorizedQuerySet, PermittedQuerySetMixin
 from trusts.zero import (
     ROOT_PK,
+    get_permission_model,
     supported_entity_contract,
     supported_permission_contract,
 )
@@ -34,7 +35,11 @@ def django_permission_filter(qs, perm, user):
     if not supported_entity_contract() or not supported_permission_contract():
         return qs.none()
     code = _condition_suffix(perm)
-    permission = resolve_content_permission(qs.model, perm)
+    Permission = get_permission_model()
+    try:
+        permission = resolve_content_permission(qs.model, perm)
+    except Permission.DoesNotExist:
+        return qs.none()
     return PermittedQuerySetMixin.permitted(
         qs, permission, user, conditions=((code,) if code else ()),
     )
@@ -58,7 +63,10 @@ def filter_scope_rows(manager, user, content, perm_name, exclude_root=True, **kw
     if not isinstance(content, type):
         content = content.__class__
     content = content._meta.concrete_model
-    permission = resolve_content_permission(content, perm_name)
+    try:
+        permission = resolve_content_permission(content, perm_name)
+    except Permission.DoesNotExist:
+        return manager.none()
     qs = filter_by_permitted_content(
         manager.filter(**kwargs), user, permission, content=content,
     )
-- 
2.43.0

